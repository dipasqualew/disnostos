# Port to listen on. Cloud Run sets this automatically.
PORT=3000

# Comma-separated list of exact origins allowed by CORS. Wildcards are ignored.
# If unset, defaults to http://localhost:5173. If empty, no origin is allowed.
ALLOWED_ORIGINS=http://localhost:5173

# GCP project whose Identity Platform tokens are accepted. If unset, every
# authenticated request is rejected.
AUTH_PROJECT_ID=

# Firestore project and private image bucket. If either is unset, trace routes
# return 503.
GCP_PROJECT_ID=
IMAGES_BUCKET=

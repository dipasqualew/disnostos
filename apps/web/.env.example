# Base URL of the disnostos API, without a trailing slash.
# Defaults to http://localhost:3000 when unset.
VITE_API_URL=http://localhost:3000

# Identity Platform web config. Deploys read these from GCP.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

# Optional: use a local Auth emulator, e.g. http://127.0.0.1:9099
VITE_AUTH_EMULATOR_URL=
